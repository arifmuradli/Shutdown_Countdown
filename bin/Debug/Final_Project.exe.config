<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <appSettings>
        <!-- Countdown duration in minutes before the computer shuts down -->
        <add key="CountdownMinutes" value="15" />
    </appSettings>
</configuration>